# Root-level reference of every configurable value. Nothing here is a secret.
# Backend (set by infrastructure/template.yaml in AWS, by local_demo/server.py locally)
NOTES_TABLE_NAME=serverless-notes-dev-notes
NOTES_USER_INDEX_NAME=byUser
CORS_ALLOW_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Frontend: see frontend/.env.example (VITE_APP_MODE=demo|aws, VITE_API_BASE_URL, Cognito ids)

# Tooling
AWS_REGION=eu-north-1
# AWS credentials: use `aws configure sso` / `aws login` or a named profile.
# Never put access keys in files inside this repository.
