# Copy to .env.aws (gitignored) and fill in the outputs of the deployed SAM stack.
# Used by `npm run dev:aws` and `npm run build -- --mode aws`.
VITE_APP_MODE=aws
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com/prod
VITE_AWS_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://your-prefix.auth.eu-north-1.amazoncognito.com
# Optional overrides (defaults: <origin>/auth/callback, <origin>/, the scopes below)
# VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OAUTH_LOGOUT_URI=http://localhost:5173/
# VITE_OAUTH_SCOPES=openid email notes/read notes/write
