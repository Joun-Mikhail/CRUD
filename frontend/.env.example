# Copy the values you need into .env.demo (committed default) or .env.aws (gitignored).
# Only VITE_* variables are exposed to the browser. Never put secrets here:
# a public SPA client has no client secret.

# demo | aws
VITE_APP_MODE=demo
# Base URL of the notes API (no trailing slash). Demo: local backend. AWS: API Gateway stage URL.
VITE_API_BASE_URL=http://127.0.0.1:8787

# --- aws mode only -------------------------------------------------------------
# VITE_AWS_REGION=eu-central-1
# VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_DOMAIN=https://your-prefix.auth.eu-central-1.amazoncognito.com
# Optional (defaults shown):
# VITE_OAUTH_REDIRECT_URI=${origin}/auth/callback
# VITE_OAUTH_LOGOUT_URI=${origin}/
# VITE_OAUTH_SCOPES=openid email notes/read notes/write
